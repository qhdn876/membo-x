<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Membo" parent="android:Theme.Material.Light.NoActionBar" tools:targetApi="31">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>

        <!-- 关掉系统默认的窗口开合动画，否则图标会跟着窗口从右侧滑入 -->
        <item name="android:windowAnimationStyle">@style/NoAnimation</item>

        <!-- Android 12+ 强制的系统 splash：透明图标 + 零时长，让它只剩一块底色 -->
        <item name="android:windowSplashScreenBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <style name="NoAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/none</item>
        <item name="android:activityOpenExitAnimation">@anim/none</item>
        <item name="android:activityCloseEnterAnimation">@anim/none</item>
        <item name="android:activityCloseExitAnimation">@anim/none</item>
    </style>

</resources>
